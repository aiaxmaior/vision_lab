# ============================================================================
# Vision Lab — UI Agent Prompts (template)
# ============================================================================
#
# Copy this file to `modes.yaml` and edit for your domain (or just edit the
# live file from the app's "UI Prompts" tab). The live `modes.yaml` is in
# .gitignore — text_prompts often contain domain-specific or character
# content you may not want in public version control.
#
# This is Source of Truth #2: the persistent chat agent.
#   - Source of Truth #1 (batch captioning) is config/prompts.json.
#
# Structure: one entry per fixed interaction mode under `ui_modes:`.
# Modes must be keyed exactly `free_form` | `analytical` | `roleplay`
# (the backend maps these to the "Free-form"/"Analytical"/"Roleplay" radios).
#
# Fields per mode:
#   interaction_mode   — display name matching the sidebar radio
#   text_prompt        — system / identity prompt injected for that mode
#   observation_prompt — Pass A ("Observe" toggle) instruction; empty string
#                        falls back to config.json's global observation_prompt
#   media_prompt.image — text auto-prepended to a normal (Observe-OFF) turn
#   media_prompt.video   when an image / video is attached, per media type
#
# Roleplay-only:
#   active_character   — currently selected character key
#   characters         — { name: { text_prompt } }; the selected character's
#                        text_prompt overrides the mode-level default
#
# Endpoints (used by the UI Prompts tab):
#   GET  /api/ui-modes   — full ui_modes object (values included, for editing)
#   POST /api/ui-modes   — persist the full ui_modes object back to this file
# ============================================================================

ui_modes:

  free_form:
    interaction_mode: "Free-form"
    text_prompt: |
      You are a workstation-integrated assistant. Help the user review and
      improve media captions. Be concise and specific.
    observation_prompt: ""
    media_prompt:
      image: ""
      video: ""

  analytical:
    interaction_mode: "Analytical"
    text_prompt: |
      You are an analytical observer. Produce a structured description of the
      provided media covering subjects, environment, activity, and framing.
      State limitations explicitly when observation is constrained.
    observation_prompt: |
      Take a careful structured observation pass. Produce ONLY a concise
      observation block — do not answer any question yet.
    media_prompt:
      image: "Describe what is visible in this image, then address the request."
      video: "Describe what happens across this video, then address the request."

  roleplay:
    interaction_mode: "Roleplay"
    observation_prompt: ""
    media_prompt:
      image: ""
      video: ""
    active_character: "narrator"
    characters:
      narrator:
        text_prompt: |
          You are a neutral narrator. Stay in scene; do not break character.
